# Copia este archivo a .env y ajusta los valores. Nunca subas .env con
# secretos reales al repositorio (ver .gitignore).

SPRING_PROFILES_ACTIVE=local

# --- Base de datos (ver compose.yml, servicio "postgres") ---
DATABASE_URL=jdbc:postgresql://localhost:5432/c21genera
DATABASE_USERNAME=c21genera
DATABASE_PASSWORD=c21genera

# --- JWT (mínimo 32 bytes; el valor de abajo es SOLO para desarrollo local) ---
JWT_SECRET=local-dev-only-secret-key-0123456789abcdef

# --- Liga pública de acceso para clientes ---
PUBLIC_LINK_BASE_URL=http://localhost:3000/e

# --- CORS: origen del frontend ---
FRONTEND_URL=http://localhost:3000

# --- Almacenamiento S3-compatible (ver compose.yml, servicio "minio") ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=c21genera-expedientes
S3_ACCESS_KEY=c21genera
S3_SECRET_KEY=c21genera-local-only

# --- Correo saliente (ver compose.yml, servicio "mailpit"; UI en http://localhost:8025) ---
MAIL_FROM=no-reply@c21genera.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Proveedor de IA documental (deshabilitado por defecto: usa el stub, nunca IA real) ---
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# --- Conversión de contrato DOCX -> PDF (requiere LibreOffice, deshabilitado por defecto) ---
PDF_CONVERSION_ENABLED=false
SOFFICE_PATH=soffice

# --- Seed de administrador de desarrollo (perfil "local" únicamente; vacío = no siembra) ---
DEV_ADMIN_EMAIL=admin@demo.local
DEV_ADMIN_PASSWORD=
